{
  "name": "clickgo-native",
  "version": "3.2.0",
  "description": "The software developed with ClickGo will run in Windows, Mac OS, Linux.",
  "type": "module",
  "keywords": [
    "clickgo",
    "clickgo-native"
  ],
  "main": "./dist/index.js",
  "author": "hanguoshuai",
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && clickgo --app ./dist/test/app",
    "check": "tsc --noEmit --pretty false && eslint \"dist/**/*.ts\" --format stylish",
    "test:mcp": "node dist/abox/test/version.mjs && node dist/abox/test/mcp.mjs",
    "test:window": "node --experimental-vm-modules dist/abox/test/window.mjs",
    "test:storage": "node --experimental-vm-modules dist/abox/test/persistence.mjs",
    "native": "electron ./dist/test",
    "sass": "sass --watch dist/:dist/ --style compressed --no-source-map",
    "test:cli": "node dist/abox/test/cli.mjs && node dist/abox/test/startup.mjs",
    "test:fs": "node dist/abox/test/fs.mjs",
    "test:update": "node --experimental-vm-modules dist/abox/test/update.mjs"
  },
  "devDependencies": {
    "@litert/eslint-plugin-rules": "^0.3.1",
    "@types/node": "^26.5.1",
    "clickgo": "^7.3.2",
    "electron": "^44.3.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "electron-updater": "^6.8.9"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/pre.js",
    "dist/lib/**/*.js",
    "dist/lib/**/*.d.ts",
    "dist/abox/**/*.js",
    "dist/abox/**/*.d.ts",
    "dist/icon.png",
    "doc/README.sc.md",
    "doc/mcp.md",
    "doc/mcp.sc.md"
  ]
}
